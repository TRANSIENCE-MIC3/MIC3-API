APP_ENV=development
APP_NAME=mic3-api
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=mic3
DB_USER=mic3_api
DB_PASSWORD=local-development-only
OIDC_ISSUER_URL=http://localhost:8080/realms/mic3
OIDC_AUDIENCE=mic3-api

# Local Keycloak infrastructure only. Use different values in .env.
# Local Compose has no SMTP integration; registration does not require email.
KEYCLOAK_PORT=8080
KEYCLOAK_MANAGEMENT_PORT=9000
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=local-keycloak-database-only
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-admin-only

# Local Kafka host listener only; Docker clients use kafka:19092.
KAFKA_PORT=9092

# Separate host-based outbox publisher (plaintext local development only).
# If KAFKA_PORT changes, also update this address.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# EOSC uses SSL and three mounted PEM files (do not set these for PLAINTEXT):
# KAFKA_SSL_CA_FILE=/var/run/mic3/kafka-trust/ca.crt
# KAFKA_SSL_CERTIFICATE_FILE=/var/run/mic3/kafka/tls.crt
# KAFKA_SSL_KEY_FILE=/var/run/mic3/kafka/tls.key
KAFKA_REQUESTS_TOPIC=mic3.run.requests.v1
KAFKA_DELIVERY_TIMEOUT_SECONDS=10
PUBLISHER_BATCH_SIZE=10
PUBLISHER_POLL_SECONDS=2

# Separate worker; add --execute to dispatch and reconcile model Jobs.
KAFKA_CONSUMER_GROUP=mic3.execution.worker.v1
WORKER_RETRY_SECONDS=2
WORKER_IDLE_TIMEOUT_SECONDS=10
WORKER_STATEMENT_TIMEOUT_MS=10000
WORKER_LOCK_TIMEOUT_MS=5000

# Required only for worker --execute. Secrets stay in ignored .env.
# In EOSC omit BOTH kubeconfig and context to use the Pod's service account.
EXECUTION_KUBECONFIG=deploy/local/kubeconfig
EXECUTION_CONTEXT=kind-mic3-local
EXECUTION_NAMESPACE=mic3-local
EXECUTION_VALUES_FILE=deploy/local/model-run.values.yaml
EXECUTION_CAPACITY=1
EXECUTION_POLL_SECONDS=2
ARTIFACT_ENDPOINT=http://127.0.0.1:19000
ARTIFACT_BUCKET=mic3-artifacts
ARTIFACT_ACCESS_KEY=
ARTIFACT_SECRET_KEY=
KAFKA_EVENTS_TOPIC=mic3.run.events.v1

