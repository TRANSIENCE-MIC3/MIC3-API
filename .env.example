APP_ENV=development
APP_NAME=mic3-api
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=mic3
DB_USER=mic3_api
DB_PASSWORD=local-development-only
OIDC_ISSUER_URL=http://localhost:8080/realms/mic3
OIDC_AUDIENCE=mic3-api

# Local Keycloak infrastructure only. Use different values in .env.
KEYCLOAK_PORT=8080
KEYCLOAK_MANAGEMENT_PORT=9000
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=local-keycloak-database-only
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-admin-only
