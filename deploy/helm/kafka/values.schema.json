{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "maxLength": 40
    },
    "image": {
      "type": "string",
      "pattern": "^apache/kafka:[^@]+@sha256:[0-9a-f]{64}$"
    },
    "clusterDomain": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "trustConfigMap": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "maxLength": 63
    },
    "certificates": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "duration": {
          "type": "string",
          "pattern": "^[0-9]+h$"
        },
        "renewBefore": {
          "type": "string",
          "pattern": "^[0-9]+h$"
        }
      }
    },
    "broker": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "clusterId": {
          "type": "string",
          "pattern": "^([A-Za-z0-9_-]{22})?$"
        },
        "heapOpts": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "accessMode": {
          "enum": [
            "ReadWriteOnce",
            "ReadWriteOncePod"
          ]
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        },
        "storageClass": {
          "type": "string"
        }
      }
    },
    "topics": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:\\.[a-z0-9]+)+$",
          "maxLength": 249
        },
        "events": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:\\.[a-z0-9]+)+$",
          "maxLength": 249
        },
        "retentionMs": {
          "type": "integer",
          "minimum": 1
        },
        "retentionBytes": {
          "type": "integer",
          "minimum": 1
        },
        "segmentBytes": {
          "type": "integer",
          "minimum": 1048576
        }
      }
    },
    "consumerGroup": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:\\.[a-z0-9]+)+$",
      "maxLength": 249
    },
    "podIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 1
        },
        "fsGroup": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "dnsPorts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "broker": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "broker": {
            "properties": {
              "clusterId": {
                "minLength": 22
              }
            }
          }
        }
      }
    }
  ]
}
