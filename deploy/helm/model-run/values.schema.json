{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
          "maxLength": 63
        },
        "mode": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
          "maxLength": 63
        },
        "image": {
          "type": "string",
          "pattern": "^.+@sha256:[0-9a-f]{64}$"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "workingDir": {
          "type": "string",
          "pattern": "^/"
        },
        "outputPath": {
          "type": "string",
          "pattern": "^/.+"
        }
      }
    },
    "copy": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^.+@sha256:[0-9a-f]{64}$"
        }
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "bucket": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
        },
        "secret": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
          "maxLength": 63
        },
        "endpoint": {
          "type": "string",
          "pattern": "^https?://[^/@?#]+/?$"
        }
      }
    },
    "activeDeadlineSeconds": {
      "type": "integer",
      "minimum": 1
    }
  }
}
