{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publisher",
    "worker",
    "database",
    "kafka",
    "artifactReaderSecret",
    "imagePullSecrets",
    "podIdentity",
    "nodeSelector",
    "modelValues",
    "networkPolicy"
  ],
  "properties": {
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "image",
        "databaseSecret",
        "tlsSecret",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "image": {
          "type": "string",
          "pattern": "^$|^[^\\s@]+@sha256:[a-f0-9]{64}$"
        },
        "databaseSecret": {
          "$ref": "#/definitions/nonempty"
        },
        "tlsSecret": {
          "$ref": "#/definitions/nonempty"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "image",
        "databaseSecret",
        "tlsSecret",
        "resources",
        "capacity"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "image": {
          "type": "string",
          "pattern": "^$|^[^\\s@]+@sha256:[a-f0-9]{64}$"
        },
        "databaseSecret": {
          "$ref": "#/definitions/nonempty"
        },
        "tlsSecret": {
          "$ref": "#/definitions/nonempty"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "capacity": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "database": {
      "type": "object",
      "required": [
        "host",
        "port"
      ],
      "additionalProperties": false,
      "properties": {
        "host": {
          "$ref": "#/definitions/nonempty"
        },
        "port": {
          "$ref": "#/definitions/port"
        }
      }
    },
    "kafka": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "clusterDomain",
        "trustConfigMap",
        "requestsTopic",
        "consumerGroup",
        "eventsTopic"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/nonempty"
        },
        "clusterDomain": {
          "$ref": "#/definitions/nonempty"
        },
        "trustConfigMap": {
          "$ref": "#/definitions/nonempty"
        },
        "requestsTopic": {
          "$ref": "#/definitions/nonempty"
        },
        "consumerGroup": {
          "$ref": "#/definitions/nonempty"
        },
        "eventsTopic": {
          "$ref": "#/definitions/nonempty"
        }
      }
    },
    "artifactReaderSecret": {
      "$ref": "#/definitions/nonempty"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/nonempty"
      }
    },
    "podIdentity": {
      "$ref": "#/definitions/identity"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/nonempty"
      }
    },
    "modelValues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage"
      ],
      "properties": {
        "podIdentity": {
          "$ref": "#/definitions/identity"
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/nonempty"
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/nonempty"
          }
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "outputSizeLimit": {
          "$ref": "#/definitions/nonempty"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resources": {
              "$ref": "#/definitions/resources"
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint",
            "bucket",
            "secret"
          ],
          "properties": {
            "endpoint": {
              "type": "string",
              "pattern": "^https?://"
            },
            "bucket": {
              "$ref": "#/definitions/nonempty"
            },
            "secret": {
              "$ref": "#/definitions/nonempty"
            }
          }
        },
        "copy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resources": {
              "$ref": "#/definitions/resources"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dnsPorts",
        "databasePeers",
        "kafkaPeers",
        "storagePeers",
        "storagePort",
        "apiPeers",
        "apiPorts"
      ],
      "properties": {
        "storagePort": {
          "$ref": "#/definitions/port"
        },
        "dnsPorts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/port"
          }
        },
        "apiPorts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/port"
          }
        },
        "databasePeers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/peer"
          }
        },
        "kafkaPeers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/peer"
          }
        },
        "storagePeers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/peer"
          }
        },
        "apiPeers": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/definitions/peer"
          }
        }
      }
    }
  },
  "definitions": {
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "required": [
            "cpu",
            "memory",
            "ephemeral-storage"
          ],
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "$ref": "#/definitions/nonempty"
            },
            "memory": {
              "$ref": "#/definitions/nonempty"
            },
            "ephemeral-storage": {
              "$ref": "#/definitions/nonempty"
            }
          }
        },
        "limits": {
          "type": "object",
          "required": [
            "cpu",
            "memory",
            "ephemeral-storage"
          ],
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "$ref": "#/definitions/nonempty"
            },
            "memory": {
              "$ref": "#/definitions/nonempty"
            },
            "ephemeral-storage": {
              "$ref": "#/definitions/nonempty"
            }
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 1
        },
        "fsGroup": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "peer": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "podSelector": {
          "type": "object"
        },
        "namespaceSelector": {
          "type": "object"
        },
        "ipBlock": {
          "type": "object",
          "required": [
            "cidr"
          ],
          "properties": {
            "cidr": {
              "$ref": "#/definitions/nonempty"
            },
            "except": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/nonempty"
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    }
  }
}
